<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同じテストを Roslyn 生成のステート マシンと runtime-async の両方で走らせるため、テスト コードは LearnAsync.Tests のものを共有する。 -->
    <Compile Include="..\LearnAsync.Tests\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sources\LearnAsync\LearnAsync.csproj" />
  </ItemGroup>

</Project>
